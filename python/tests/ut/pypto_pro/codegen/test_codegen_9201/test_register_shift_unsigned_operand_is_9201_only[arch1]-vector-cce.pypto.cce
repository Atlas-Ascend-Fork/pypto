#include <pypto_dump.h>
#include <pypto_vf_support.h>
__simd_vf__ inline void _register_shift(__ubuf__ int32_t* src_0, uint32_t src_0__valid_row, uint32_t src_0__valid_col, __ubuf__ int32_t* shift_0, uint32_t shift_0__valid_row, uint32_t shift_0__valid_col, __ubuf__ int32_t* dst_0, uint32_t dst_0__valid_row, uint32_t dst_0__valid_col)
{
    MaskReg mask_0;
    mask_0 = pset_b32(PAT_ALL);
    RtWrap<int32_t> value_0;
    vlds(value_0, src_0, 0, NORM);
    RtWrap<int32_t> amount_0;
    vlds(amount_0, shift_0, 0, NORM);
    RtWrap<int32_t> result_0;
    vshl(result_0, value_0, (RegTensor<uint32_t>&)amount_0, mask_0, MODE_ZEROING);
    vsts(result_0, dst_0, 0, NORM_B32, mask_0);
    return;
}

__aicore__ inline void _shift_kernel_impl_vector(__gm__ int32_t* x_0)
{

    using src_0_Type = SyncedTile<Tile<TileType::Vec, int32_t, 1, 64, BLayout::RowMajor, -1, -1, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Normal>, 0>;
    src_0_Type src_0{src_0_Type::PtoTile(1, 64), {}};
    TASSIGN(src_0.tile, 0x0);
    using shift_0_Type = SyncedTile<Tile<TileType::Vec, int32_t, 1, 64, BLayout::RowMajor, -1, -1, SLayout::NoneBox, 512, PadValue::Null, CompactMode::Normal>, 0>;
    shift_0_Type shift_0{shift_0_Type::PtoTile(1, 64), {}};
