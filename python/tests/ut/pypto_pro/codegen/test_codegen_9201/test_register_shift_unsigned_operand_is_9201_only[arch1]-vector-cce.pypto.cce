    _register_shift((__ubuf__ int32_t *)src_0.tile.data(), (uint32_t)src_0.tile.GetValidRow(), (uint32_t)src_0.tile.GetValidCol(), (__ubuf__ int32_t *)shift_0.tile.data(), (uint32_t)shift_0.tile.GetValidRow(), (uint32_t)shift_0.tile.GetValidCol(), (__ubuf__ int32_t *)dst_0.tile.data(), (uint32_t)dst_0.tile.GetValidRow(), (uint32_t)dst_0.tile.GetValidCol());
    return;
}
