program #entry() {
    function _register_shift incast(mutex_tile<tile<1 x 64, int32_t, tile_view<-1 x -1>, hw_info<row_major, none_box, 512, null, normal>>, 0> %src_0, mutex_tile<tile<1 x 64, int32_t, tile_view<-1 x -1>, hw_info<row_major, none_box, 512, null, normal>>, 0> %shift_0, mutex_tile<tile<1 x 64, int32_t, tile_view<-1 x -1>, hw_info<row_major, none_box, 512, null, normal>>, 0> %dst_0) outcast() #entry(false) #type(SimdVF) {
