class Window:
    """Symmetric window registered on an HCCL comm (host-side handle)."""

    def rank(self) -> int: ...
    def nrank(self) -> int: ...
    def data_ptr(self) -> int: ...
    def support_multi_issuer(self) -> bool: ...
    def connected(self) -> bool: ...
    def register_memory(self, tensor_addr: int, size: int, name: str, protocol: int) -> None: ...
    def connect(self) -> None: ...
    def close(self) -> None: ...
    def __str__(self) -> str: ...


def create_window(
    rank: int,
    nrank: int,
    stream: int,
    hccl_name: str,
    name: str = ...,
    layer: int = ...,
) -> Window: ...


def dump_topology(hccl_name: str, rank: int, nrank: int, layer: int = ...) -> str: ...
